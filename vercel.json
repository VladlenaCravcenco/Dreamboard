{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/u/:slug",
      "destination": "/api/share-preview?path=u/:slug"
    },
    {
      "source": "/invite/:token",
      "destination": "/api/share-preview?path=invite/:token"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/product-preview.js": {
      "maxDuration": 30
    },
    "api/share-preview.js": {
      "includeFiles": "dist/app.html"
    }
  }
}
